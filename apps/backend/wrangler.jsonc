{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-backend-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prod-d1-db",
      "database_id": "c2ea3402-ba09-4223-bbfc-7511b00b9e85"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MY_BUCKET",
      "bucket_name": "prod-r2-bucket"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MY_KV", // 代码中访问时使用的变量名 (例如 env.MY_KV)
      "id": "8679e664b6894115aa4b7d3b74d05f6c" // 刚才通过命令行获取到的生产环境 ID
    }
  ]
}
